# Anthropic API key (https://console.anthropic.com). Never commit your real .env.
ANTHROPIC_API_KEY=
# Model used by the receptionist. Haiku is fast and cheap for chat; Sonnet for harder cases.
ANTHROPIC_MODEL=claude-haiku-5-5
# Which business config to load from server/businesses/<id>.json
BUSINESS_ID=clasico-barber
PORT=8787
# Optional: POST every owner notification as JSON to this URL (Slack/Zapier/n8n webhook).
OWNER_WEBHOOK_URL=
# Optional: protect the owner dashboard API. Send it as the x-owner-token header.
OWNER_TOKEN=

{
  "name": "ai-receptionist",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bilingual (EN/ES) AI receptionist for small businesses, built on the Claude API with tool use.",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"node --watch server/index.js\" \"vite\"",
    "server": "node server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test tests/*.test.js",
    "evals": "node evals/run.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^8.0.0"
  }
}
